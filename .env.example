NODE_ENV=development
DATABASE_CONNECTION_STRING=mongodb+srv://<database-user>:<url-encoded-password>@<atlas-cluster-host>/ticketify?retryWrites=true&w=majority
JWT_SECRET_CODE=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Configure these when email and payment features are enabled.
NODE_MAILER_HOST=
NODE_MAILER_PORT=
NODE_MAILER_USERNAME=
NODE_MAILER_PASSWORD=
STRIPE_SECRET_KEY=
